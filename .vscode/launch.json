{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "rust:linux",
            "cargo": {
                "args": [
                    "build",
                    "--bin=${workspaceFolderBasename}",
                    "--package=${workspaceFolderBasename}",
                    "--target=x86_64-unknown-linux-gnu",
                    "--features=pc"
                ],
                "filter": {
                    "name": "main",
                    "kind": "bin"
                }
            },
            "args": ["lib/${workspaceFolderBasename}.ini"],
            "cwd": "${workspaceFolder}"
            "stopOnEntry": true,
            "preLaunchTask": "cargo: build",
            "preRunCommands": [
                "process launch --stop-at-entry"
            ]
        },
    ]
}
